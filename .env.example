# Plugin Debug Mode (development only)
# Get REMOTE_INSTALL_KEY from Dify Studio: Plugins -> Debug -> "Get Debugging Key"

INSTALL_METHOD=remote
REMOTE_INSTALL_HOST=debug.dify.ai
REMOTE_INSTALL_PORT=5003
REMOTE_INSTALL_KEY=your-debug-key-here

# Plugin runtime
PYTHON_BASIC_AUTH_USERNAME=
PYTHON_BASIC_AUTH_PASSWORD=
